window.ReactNativeWebView = {
  postMessage: function(message) {
    window.postMessage({ type: "FP_TOKEN_CAPTURED", payload: message }, "*");
    let count = 0;
    const timer = setInterval(() => {
      window.postMessage({ type: "FP_TOKEN_CAPTURED", payload: message }, "*");
      count++;
      if (count >= 5) clearInterval(timer);
    }, 400);
  }
};

