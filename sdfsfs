popup.js





document.addEventListener("DOMContentLoaded", () => {
  const input = document.getElementById("botUrl");
  const fpStatus = document.getElementById("fpStatus");
  const lastLog = document.getElementById("lastLog");

  function refreshUI() {
    chrome.storage.local.get(["botUrl", "fpConnected", "lastLog"], (res) => {
      if (res.botUrl) input.value = res.botUrl;
      if (res.fpConnected) {
        fpStatus.innerText = "Активен (14 дн.) 🟢";
        fpStatus.style.color = "#10b981";
      } else {
        fpStatus.innerText = "Ожидание входа ❌";
        fpStatus.style.color = "#ef4444";
      }
      if (res.lastLog) lastLog.innerText = res.lastLog;
    });
  }

  document.getElementById("saveBtn").addEventListener("click", () => {
    let url = input.value.trim().replace(/\/+$/, "");
    if (!url) return;
    chrome.storage.local.set({ botUrl: url, lastLog: "✅ Ссылка сохранена!" }, refreshUI);
  });

  document.getElementById("loginBtn").addEventListener("click", () => {
    chrome.tabs.create({ url: "https://companion-rust.facepunch.com/login" });
  });

  refreshUI();
});
